<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/login.css" />

<body>
  <form class="login-container" action="/admin/login" METHOD="POST">
    <div class="login-frame">
      <div class="login-top">
        <span>Enter</span>
        <div>Go back <a href="/admin" style="color: #6440fb">Home</a></div>
        <p>
          Not registered yet?
          <a href="/admin/signup" style="color: #6440fb">Signup</a>
        </p>
      </div>
      <div class="login-input-frame">
        <% if (typeof error !== 'undefined' && error) { %>
          <p class="login-error" role="alert"><%= error %></p>
        <% } %>
        <div class="login-input-container">
          <label for="memberNick">Restaurant *</label>
          <input
            type="text"
            id="memberNick"
            name="memberNick"
            class="member-nick"
            placeholder="Username"
            value="<%= typeof memberNick !== 'undefined' ? memberNick : '' %>"
            autocomplete="username"
            required
          /> 
        </div>
        <div class="login-input-container">
          <label for="memberPassword">Password *</label>
          <input
            type="password"
            id="memberPassword"
            name="memberPassword"
            class="member-password"
            placeholder="Password"
            autocomplete="current-password"
            required
          />
        </div>
      </div>
      <button class="login-btn btn" name="login" type="submit">Login</button>
    </div>
  </form>
</body>

<%- include('includes/footer') %>
